---
// A section divider drawn like a quantum circuit. Gates light up on scroll.
---

<div class="circuit reveal" aria-hidden="true">
  <svg viewBox="0 0 1000 70" preserveAspectRatio="none">
    <line x1="0" y1="20" x2="1000" y2="20" class="wire" />
    <line x1="0" y1="50" x2="1000" y2="50" class="wire" />
    <text x="8" y="24" class="lbl">|0⟩</text>
    <text x="8" y="54" class="lbl">|0⟩</text>
    <g class="gate g1"><rect x="150" y="8" width="26" height="24" rx="4" /><text x="163" y="25">H</text></g>
    <g class="gate g2">
      <line x1="330" y1="20" x2="330" y2="50" class="ctl" />
      <circle cx="330" cy="20" r="4.5" class="dot" />
      <circle cx="330" cy="50" r="9" class="tgt" />
      <line x1="321" y1="50" x2="339" y2="50" class="ctl" /><line x1="330" y1="41" x2="330" y2="59" class="ctl" />
    </g>
    <g class="gate g3"><rect x="520" y="38" width="34" height="24" rx="4" /><text x="537" y="55">Rz</text></g>
    <g class="gate g4"><rect x="700" y="8" width="26" height="24" rx="4" /><text x="713" y="25">H</text></g>
    <g class="gate g5">
      <path d="M860 32 a12 12 0 0 1 24 0" class="meter" /><line x1="872" y1="32" x2="880" y2="14" class="ctl" />
      <rect x="856" y="8" width="32" height="28" rx="4" class="mbox" />
      <path d="M860 62 a12 12 0 0 1 24 0" class="meter" /><line x1="872" y1="62" x2="880" y2="44" class="ctl" />
      <rect x="856" y="38" width="32" height="28" rx="4" class="mbox" />
    </g>
  </svg>
</div>

<style>
  .circuit {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 var(--gutter);
    opacity: 1;
    transform: none;
    overflow: hidden;
  }
  svg { width: 100%; min-width: 640px; height: 56px; }
  .wire { stroke: var(--border); stroke-width: 1.5; }
  .lbl { fill: var(--text-dim); font: 12px var(--font-mono); }
  .gate rect { fill: var(--bg); stroke: var(--border); stroke-width: 1.5; transition: stroke 0.5s, fill 0.5s; }
  .gate text { fill: var(--text-dim); font: 600 13px var(--font-mono); text-anchor: middle; transition: fill 0.5s; }
  .ctl { stroke: var(--text-dim); stroke-width: 1.5; transition: stroke 0.5s; }
  .dot { fill: var(--text-dim); transition: fill 0.5s; }
  .tgt { fill: none; stroke: var(--text-dim); stroke-width: 1.5; transition: stroke 0.5s; }
  .meter { fill: none; stroke: var(--text-dim); stroke-width: 1.5; transition: stroke 0.5s; }
  .mbox { fill: none !important; }
  .gate { transition-delay: calc(var(--i) * 180ms); }
  .g1 { --i: 0; } .g2 { --i: 1; } .g3 { --i: 2; } .g4 { --i: 3; } .g5 { --i: 4; }
  .g1 *, .g2 *, .g3 *, .g4 *, .g5 * { transition-delay: inherit; }
  .circuit.is-visible .gate rect { stroke: var(--accent-2); fill: color-mix(in srgb, var(--accent-2) 12%, var(--bg)); }
  .circuit.is-visible .gate text { fill: var(--text); }
  .circuit.is-visible .ctl, .circuit.is-visible .tgt, .circuit.is-visible .meter { stroke: var(--accent); }
  .circuit.is-visible .dot { fill: var(--accent); }
</style>
