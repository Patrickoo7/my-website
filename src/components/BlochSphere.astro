---
// Interactive Bloch sphere. The state precesses; clicking "measures" it,
// collapsing to |0⟩ or |1⟩ with Born-rule probabilities, then re-prepares.
---

<figure class="bloch">
  <canvas class="bloch-canvas" width="320" height="320" role="img" aria-label="Animated Bloch sphere showing a qubit state"></canvas>
  <figcaption class="mono">
    <div class="state" aria-live="polite">|ψ⟩ = …</div>
    <div class="probs"></div>
    <button class="btn measure" type="button">⟨measure⟩</button>
  </figcaption>
</figure>

<style>
  .bloch {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }
  .bloch-canvas {
    width: min(100%, 320px);
    aspect-ratio: 1;
    cursor: pointer;
  }
  figcaption {
    text-align: center;
    font-size: 0.85rem;
    color: var(--text-dim);
    display: grid;
    gap: 8px;
    justify-items: center;
  }
  .state {
    color: var(--text);
    font-size: 0.95rem;
    min-height: 1.6em;
  }
  .measure {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    padding: 0.5em 1.1em;
    cursor: pointer;
  }
</style>

<script>
  function initBloch(fig: HTMLElement) {
    const canvas = fig.querySelector<HTMLCanvasElement>('canvas')!;
    const stateEl = fig.querySelector<HTMLElement>('.state')!;
    const probsEl = fig.querySelector<HTMLElement>('.probs')!;
    const btn = fig.querySelector<HTMLButtonElement>('.measure')!;
    const ctx = canvas.getContext('2d')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const S = 320, dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = S * dpr;
    canvas.height = S * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    const cx = S / 2, cy = S / 2, R = 118;
    const elev = 0.38; // camera tilt
    let az = 0.6; // camera azimuth

    let theta = 1.1, phi = 0;
    let targetTheta = theta;
    let measured: 0 | 1 | null = null;
    let colors = read();

    function read() {
      const cs = getComputedStyle(document.documentElement);
      return {
        text: cs.getPropertyValue('--text').trim(),
        dim: cs.getPropertyValue('--text-dim').trim(),
        a: cs.getPropertyValue('--particle').trim(),
        b: cs.getPropertyValue('--particle-2').trim(),
      };
    }

    function project(x: number, y: number, z: number) {
      const x1 = x * Math.cos(az) - y * Math.sin(az);
      const y1 = x * Math.sin(az) + y * Math.cos(az);
      const sy = z * Math.cos(elev) - y1 * Math.sin(elev);
      const depth = y1 * Math.cos(elev) + z * Math.sin(elev);
      return { X: cx + R * x1, Y: cy - R * sy, depth };
    }

    function ring(f: (t: number) => [number, number, number], rgb: string) {
      const N = 90;
      for (let i = 0; i < N; i++) {
        const p = project(...f((i / N) * Math.PI * 2));
        const q = project(...f(((i + 1) / N) * Math.PI * 2));
        const front = (p.depth + q.depth) / 2 < 0;
        ctx.strokeStyle = `rgba(${rgb}, ${front ? 0.55 : 0.18})`;
        ctx.lineWidth = front ? 1.2 : 1;
        ctx.beginPath();
        ctx.moveTo(p.X, p.Y);
        ctx.lineTo(q.X, q.Y);
        ctx.stroke();
      }
    }

    function axis(v: [number, number, number], label: string) {
      const o = project(0, 0, 0);
      const p = project(...v);
      ctx.strokeStyle = `rgba(${colors.a}, 0.35)`;
      ctx.setLineDash([3, 4]);
      ctx.beginPath();
      ctx.moveTo(o.X, o.Y);
      ctx.lineTo(p.X, p.Y);
      ctx.stroke();
      ctx.setLineDash([]);
      const l = project(v[0] * 1.18, v[1] * 1.18, v[2] * 1.18);
      ctx.fillStyle = colors.dim;
      ctx.font = '13px "JetBrains Mono", monospace';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(label, l.X, l.Y);
    }

    function draw() {
      ctx.clearRect(0, 0, S, S);
      // sphere glow
      const g = ctx.createRadialGradient(cx - 30, cy - 40, 10, cx, cy, R);
      g.addColorStop(0, `rgba(${colors.b}, 0.10)`);
      g.addColorStop(1, `rgba(${colors.a}, 0.04)`);
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.arc(cx, cy, R, 0, Math.PI * 2);
      ctx.fill();
      ctx.strokeStyle = `rgba(${colors.a}, 0.5)`;
      ctx.lineWidth = 1.2;
      ctx.stroke();

      ring((t) => [Math.cos(t), Math.sin(t), 0], colors.a);
      ring((t) => [Math.cos(t), 0, Math.sin(t)], colors.b);

      axis([0, 0, 1], '|0⟩');
      axis([0, 0, -1], '|1⟩');
      axis([1, 0, 0], '|+⟩');
      axis([0, 1, 0], '|i⟩');

      // state vector
      const v: [number, number, number] = [
        Math.sin(theta) * Math.cos(phi),
        Math.sin(theta) * Math.sin(phi),
        Math.cos(theta),
      ];
      const o = project(0, 0, 0);
      const p = project(...v);
      // projection shadow on equator
      const sh = project(v[0], v[1], 0);
      ctx.strokeStyle = `rgba(${colors.b}, 0.3)`;
      ctx.setLineDash([2, 3]);
      ctx.beginPath();
      ctx.moveTo(p.X, p.Y);
      ctx.lineTo(sh.X, sh.Y);
      ctx.lineTo(o.X, o.Y);
      ctx.stroke();
      ctx.setLineDash([]);

      const grad = ctx.createLinearGradient(o.X, o.Y, p.X, p.Y);
      grad.addColorStop(0, `rgba(${colors.a}, 1)`);
      grad.addColorStop(1, `rgba(${colors.b}, 1)`);
      ctx.strokeStyle = grad;
      ctx.lineWidth = 3;
      ctx.lineCap = 'round';
      ctx.beginPath();
      ctx.moveTo(o.X, o.Y);
      ctx.lineTo(p.X, p.Y);
      ctx.stroke();

      ctx.fillStyle = `rgba(${colors.b}, 0.25)`;
      ctx.beginPath();
      ctx.arc(p.X, p.Y, 11, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = `rgb(${colors.b})`;
      ctx.beginPath();
      ctx.arc(p.X, p.Y, 5, 0, Math.PI * 2);
      ctx.fill();
    }

    function updateText() {
      if (measured !== null) {
        stateEl.textContent = `measured → |${measured}⟩`;
        return;
      }
      const a = Math.cos(theta / 2), b = Math.sin(theta / 2);
      const deg = Math.round(((phi % (2 * Math.PI)) * 180) / Math.PI);
      stateEl.textContent = `|ψ⟩ = ${a.toFixed(2)}|0⟩ + e^{i${deg}°}·${b.toFixed(2)}|1⟩`;
      probsEl.textContent = `P(0) = ${(a * a).toFixed(2)} · P(1) = ${(b * b).toFixed(2)}`;
    }

    function measure() {
      if (measured !== null) return;
      const p0 = Math.cos(theta / 2) ** 2;
      measured = Math.random() < p0 ? 0 : 1;
      targetTheta = measured === 0 ? 0.0001 : Math.PI - 0.0001;
      probsEl.textContent = `outcome had probability ${(measured === 0 ? p0 : 1 - p0).toFixed(2)}`;
      updateText();
      if (reduce) { theta = targetTheta; draw(); }
      setTimeout(() => {
        measured = null;
        targetTheta = 0.4 + Math.random() * (Math.PI - 0.8);
        if (reduce) { theta = targetTheta; draw(); }
        updateText();
      }, 2200);
    }

    let raf = 0, running = false, frame = 0;
    function loop() {
      if (measured === null) phi += 0.012; // Larmor precession
      az += 0.002;
      theta += (targetTheta - theta) * 0.08;
      draw();
      if (++frame % 6 === 0) updateText();
      raf = requestAnimationFrame(loop);
    }
    const start = () => { if (!running && !reduce) { running = true; raf = requestAnimationFrame(loop); } };
    const stop = () => { running = false; cancelAnimationFrame(raf); };

    draw();
    updateText();
    canvas.addEventListener('click', measure);
    btn.addEventListener('click', measure);
    new IntersectionObserver(([e]) => (e.isIntersecting ? start() : stop())).observe(canvas);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    window.addEventListener('themechange', () => { colors = read(); draw(); });
  }

  document.querySelectorAll<HTMLElement>('.bloch').forEach(initBloch);
</script>
