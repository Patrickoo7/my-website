---
interface Props { words: string[] }
const { words } = Astro.props;
---

<span class="typing mono" data-words={JSON.stringify(words)}>
  <span class="typed">{words[0]}</span><span class="caret" aria-hidden="true">▍</span>
</span>

<style>
  .typing { color: var(--accent); }
  .caret {
    color: var(--accent-2);
    margin-left: 2px;
    animation: blink 1s steps(1) infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.typing').forEach((el) => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const words: string[] = JSON.parse(el.dataset.words || '[]');
    const out = el.querySelector<HTMLElement>('.typed')!;
    let w = 0, i = words[0].length, deleting = true;
    const tick = () => {
      const word = words[w];
      i += deleting ? -1 : 1;
      out.textContent = word.slice(0, i);
      let delay = deleting ? 35 : 70;
      if (!deleting && i === word.length) { deleting = true; delay = 1800; }
      else if (deleting && i === 0) { deleting = false; w = (w + 1) % words.length; delay = 300; }
      setTimeout(tick, delay);
    };
    setTimeout(tick, 2000);
  });
</script>
