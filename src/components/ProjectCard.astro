---
interface Props {
  title: string;
  summary: string;
  tags: string[];
  year: number;
  highlight?: string;
  repo?: string;
  link?: string;
  category?: string;
}
import { url } from '../data/url';
const { title, summary, tags, year, highlight, repo, link, category } = Astro.props;
const internal = link?.startsWith('/');
const href = internal ? url(link!) : link;
---

<article class="card project reveal" data-category={category} data-tags={tags.join('|')}>
  <div class="top mono">
    <span class="kind">{category ?? 'project'}</span>
    <span class="year">{year}</span>
  </div>
  <h3>{title}</h3>
  {highlight && <p class="highlight">{highlight}</p>}
  <p class="summary">{summary}</p>
  <div class="tags">{tags.map((t) => <span class="tag">{t}</span>)}</div>
  {
    (repo || link) && (
      <div class="links mono">
        {repo && <a href={repo} target="_blank" rel="noopener">code ↗</a>}
        {href && (internal ? <a href={href}>try it →</a> : <a href={href} target="_blank" rel="noopener">live ↗</a>)}
      </div>
    )
  }
</article>

<style>
  .project {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: transform 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease;
    overflow: hidden;
  }
  .project::before {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    background: var(--grad);
    opacity: 0;
    transition: opacity 0.35s;
    z-index: -1;
    filter: blur(24px);
  }
  .project:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--accent-2) 60%, transparent);
    box-shadow: 0 18px 50px -25px var(--violet);
  }
  .project:hover::before { opacity: 0.12; }
  .top {
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
    color: var(--text-dim);
  }
  .kind { color: var(--accent-2); font-family: var(--font-sans); font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; font-size: 0.72rem; }
  h3 { margin: 0; }
  .highlight { margin: 0; font-size: 0.85rem; font-weight: 600; color: var(--accent); }
  .summary { color: var(--text-dim); font-size: 0.95rem; margin: 0; flex: 1; }
  .links { display: flex; gap: 16px; font-size: 0.85rem; }
</style>
