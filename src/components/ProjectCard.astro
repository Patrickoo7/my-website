---
interface Props {
  title: string;
  summary: string;
  tags: string[];
  year: number;
  highlight?: string;
  repo?: string;
  link?: string;
  category?: string;
}
import { url } from '../data/url';
const { title, summary, tags, year, highlight, repo, link, category } = Astro.props;
const internal = link?.startsWith('/');
const href = internal ? url(link!) : link;
---

<article class="card project reveal" data-category={category} data-tags={tags.join('|')}>
  <div class="top mono">
    <span class="ket">|{category ?? 'project'}⟩</span>
    <span class="year">{year}</span>
  </div>
  <h3 data-title={title}>{title}</h3>
  {highlight && <p class="highlight mono">★ {highlight}</p>}
  <p class="summary">{summary}</p>
  <div class="tags">{tags.map((t) => <span class="tag">{t}</span>)}</div>
  {
    (repo || link) && (
      <div class="links mono">
        {repo && <a href={repo} target="_blank" rel="noopener">code ↗</a>}
        {href && (internal ? <a href={href}>try it →</a> : <a href={href} target="_blank" rel="noopener">live ↗</a>)}
      </div>
    )
  }
</article>

<style>
  .project {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: transform 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease;
    overflow: hidden;
  }
  .project::before {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    background: var(--grad);
    opacity: 0;
    transition: opacity 0.35s;
    z-index: -1;
    filter: blur(24px);
  }
  .project:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--accent-2) 60%, transparent);
    box-shadow: 0 18px 50px -25px var(--violet);
  }
  .project:hover::before { opacity: 0.12; }
  .top {
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
    color: var(--text-dim);
  }
  .ket { color: var(--accent-2); }
  h3 { margin: 0; position: relative; }
  /* superposition: a ghost copy of the title splits off then collapses back */
  h3::after {
    content: attr(data-title);
    position: absolute;
    inset: 0;
    color: var(--accent);
    opacity: 0;
    pointer-events: none;
  }
  .project:hover h3::after { animation: superpose 0.6s ease; }
  @keyframes superpose {
    0% { opacity: 0; transform: none; filter: blur(0); }
    35% { opacity: 0.6; transform: translate(5px, -2px); filter: blur(1.5px); }
    100% { opacity: 0; transform: none; filter: blur(0); }
  }
  .highlight { margin: 0; font-size: 0.82rem; color: var(--accent); }
  .summary { color: var(--text-dim); font-size: 0.95rem; margin: 0; flex: 1; }
  .links { display: flex; gap: 16px; font-size: 0.85rem; }
</style>
