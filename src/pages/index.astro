---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import QubitCanvas from '../components/QubitCanvas.astro';
import CircuitDivider from '../components/CircuitDivider.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile } from '../data/profile';
import { url } from '../data/url';

const featured = (await getCollection('projects', (p) => p.data.featured)).sort((a, b) => a.data.order - b.data.order);
const pubs = (await getCollection('publications')).sort((a, b) => b.data.year - a.data.year || a.data.order - b.data.order);
const boldName = (authors: string) => authors.replace(profile.name, `<strong>${profile.name}</strong>`);
---

<BaseLayout>
  <section class="hero">
    <QubitCanvas />
    <div class="container hero-inner">
      <div class="hero-text">
        <h1 class="grad-text">{profile.name}</h1>
        <p class="role">{profile.role}</p>
        <p class="lead">{profile.tagline}</p>
        <p class="focus">
          <span class="dim">Interests:</span>
          <span class="areas">{profile.focusAreas.join(' · ')}</span>
        </p>
        <div class="cta">
          <a class="btn btn-primary" href={url('/research')}>Research & publications</a>
          <a class="btn" href={url('/cv')}>CV & resume</a>
        </div>
        <p class="links">
          <a href={`mailto:${profile.email}`}>Email</a>
          <a href={profile.links.github} target="_blank" rel="noopener">GitHub</a>
          <a href={profile.links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
          <a href={profile.links.orcid} target="_blank" rel="noopener">ORCID</a>
        </p>
      </div>
      <div class="hero-photo">
        <div class="orbit" aria-hidden="true"><span></span><span></span></div>
        <img src={url('/profile.jpg')} alt={`Portrait of ${profile.name}`} width="800" height="800" />
      </div>
    </div>
  </section>

  <section class="stats container" aria-label="Highlights">
    {
      profile.stats.map((s) => (
        <div class="stat reveal">
          <span class="value grad-text">{s.value}</span>
          <span class="label">{s.label}</span>
        </div>
      ))
    }
  </section>

  <p class="container open reveal">{profile.openTo}</p>

  <CircuitDivider />

  <section class="section container record">
    <div class="reveal">
      <h2>Selected publications</h2>
      <ol class="pubs">
        {
          pubs.map((p) => (
            <li>
              <h3>{p.data.url ? <a href={p.data.url} target="_blank" rel="noopener">{p.data.title}</a> : p.data.title}</h3>
              <p class="authors" set:html={boldName(p.data.authors)} />
              <p class="venue">
                {p.data.venue}, {p.data.year}
                {p.data.note && <span class="note"> · {p.data.note}</span>}
              </p>
            </li>
          ))
        }
      </ol>
      <a class="text-link" href={url('/research')}>All research →</a>
    </div>
    <aside class="reveal news" aria-labelledby="news-h">
      <h2 id="news-h">News</h2>
      <ul>
        {
          profile.news.map((n) => (
            <li>
              <span class="date">{n.date}</span>
              <span>{n.text}</span>
            </li>
          ))
        }
      </ul>
    </aside>
  </section>

  <CircuitDivider />

  <section class="section container about reveal">
    <h2>About</h2>
    {profile.bio.map((p) => <p class="lead">{p}</p>)}
    <a class="text-link" href={url('/about')}>Education, skills and certifications →</a>
  </section>

  <section class="section container">
    <div class="reveal">
      <h2>Selected work</h2>
    </div>
    <div class="grid">
      {featured.map((p) => <ProjectCard {...p.data} />)}
    </div>
    <p class="more"><a class="btn" href={url('/projects')}>All projects →</a></p>
  </section>

  <section class="section container">
    <div class="audiences">
      <a class="card audience reveal" href={url('/research')}>
        <span class="eyebrow">For academia</span>
        <h3>Research & publications</h3>
        <p>Research interests in quantum error correction, the CLEF 2026 papers, and research experience at Georgia Tech.</p>
        <span class="go">View research →</span>
      </a>
      <a class="card audience reveal" href={url('/cv')}>
        <span class="eyebrow">For industry</span>
        <h3>Resume & experience</h3>
        <p>4.5+ years building production computer-vision and LLM systems, from edge devices to cloud microservices.</p>
        <span class="go">View resume →</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: 92svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding: 100px 0 60px;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 160px;
    background: linear-gradient(transparent, var(--bg));
    pointer-events: none;
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 48px;
    align-items: center;
  }
  h1 {
    margin-bottom: 0.2em;
    padding-bottom: 0.05em;
  }
  .role {
    font-size: clamp(1.15rem, 2.4vw, 1.5rem);
    font-weight: 600;
    margin-bottom: 0.8em;
  }
  .focus {
    font-size: 0.98rem;
    margin-bottom: 1.4em;
  }
  .areas {
    color: var(--accent);
    font-weight: 500;
  }
  .dim { color: var(--text-dim); }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    margin-top: 22px;
    font-size: 0.92rem;
  }

  .hero-photo {
    position: relative;
    justify-self: center;
    width: min(100%, 340px);
    aspect-ratio: 1;
  }
  .hero-photo img {
    position: absolute;
    inset: 12%;
    width: 76%;
    height: 76%;
    object-fit: cover;
    object-position: 50% 20%;
    border-radius: 50%;
    border: 2px solid var(--border);
    box-shadow: 0 30px 80px -30px var(--violet);
  }
  .orbit {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px dashed color-mix(in srgb, var(--accent-2) 50%, transparent);
    animation: spin 18s linear infinite;
  }
  .orbit span {
    position: absolute;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 16px var(--accent);
    top: -6px;
    left: calc(50% - 6px);
  }
  .orbit span:last-child {
    top: auto;
    bottom: -6px;
    background: var(--accent-2);
    box-shadow: 0 0 16px var(--accent-2);
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    padding-top: 24px;
    padding-bottom: 20px;
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 18px;
    border-left: 2px solid var(--border);
  }
  .value { font-size: 2.2rem; font-weight: 800; line-height: 1; }
  .label { font-size: 0.88rem; color: var(--text-dim); }
  .open {
    color: var(--text-dim);
    font-size: 0.98rem;
    padding-bottom: 40px;
  }

  .record {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 56px;
    align-items: start;
  }
  .pubs {
    list-style: none;
    padding: 0;
    margin: 0 0 20px;
    display: grid;
    gap: 22px;
  }
  .pubs h3 { font-size: 1.02rem; line-height: 1.45; margin-bottom: 4px; }
  .pubs h3 a { color: var(--text); }
  .pubs h3 a:hover { color: var(--accent); }
  .authors { color: var(--text-dim); font-size: 0.92rem; margin: 0 0 2px; }
  .authors :global(strong) { color: var(--text); font-weight: 600; }
  .venue { font-size: 0.88rem; color: var(--accent); margin: 0; }
  .note { color: var(--text-dim); }
  .news ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 16px; }
  .news li {
    display: grid;
    gap: 2px;
    padding-left: 14px;
    border-left: 2px solid var(--border);
    font-size: 0.94rem;
  }
  .date {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-2);
  }
  .text-link { font-weight: 500; font-size: 0.95rem; }

  .about .lead { max-width: 72ch; }

  .more { margin-top: 28px; text-align: center; }

  .audiences {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .audience {
    color: var(--text);
    padding: 32px;
    transition: transform 0.3s, border-color 0.3s;
  }
  .audience:hover { text-decoration: none; transform: translateY(-4px); border-color: var(--accent); }
  .audience p { color: var(--text-dim); }
  .audience .eyebrow { display: block; margin-bottom: 0.4em; }
  .audience h3 { font-size: 1.5rem; }
  .go { color: var(--accent); font-size: 0.92rem; font-weight: 500; }

  @media (max-width: 860px) {
    .hero-inner, .record, .audiences { grid-template-columns: 1fr; }
    .hero-photo { order: -1; width: min(70%, 260px); }
    .hero { padding-top: 90px; min-height: auto; }
    .stats { grid-template-columns: repeat(2, 1fr); }
    .record { gap: 40px; }
  }
  @media (max-width: 420px) {
    .cta .btn { width: 100%; justify-content: center; }
  }
</style>
