---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlochSphere from '../components/BlochSphere.astro';
import CircuitDivider from '../components/CircuitDivider.astro';
import { profile } from '../data/profile';
---

<BaseLayout title="About" description={`About ${profile.name}: background, education, skills and research interests.`}>
  <section class="container page-head">
    <p class="prompt">cat about.md</p>
    <h1>About <span class="grad-text">me</span></h1>
  </section>

  <section class="container intro">
    <div class="reveal">
      {profile.bio.map((p) => <p class="lead">{p}</p>)}
    </div>
    <div class="reveal"><BlochSphere /></div>
  </section>

  <CircuitDivider />

  <section class="section container">
    <p class="prompt">ls education/</p>
    <h2>Education</h2>
    <div class="edu">
      {
        profile.education.map((e) => (
          <div class="card reveal">
            <span class="mono period">{e.period}</span>
            <h3>{e.degree}</h3>
            <p class="school">{e.school}</p>
            {e.detail && <p class="detail">{e.detail}</p>}
          </div>
        ))
      }
    </div>
  </section>

  <section class="section container">
    <p class="prompt">pip list --skills</p>
    <h2>Skills</h2>
    <div class="grid">
      {
        Object.entries(profile.skills).map(([group, items]) => (
          <div class="card reveal">
            <h3>{group}</h3>
            <div class="tags">{items.map((s) => <span class="tag">{s}</span>)}</div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section container two">
    <div class="reveal">
      <p class="prompt">cat certifications.txt</p>
      <h2>Certifications</h2>
      <ul class="list">{profile.certifications.map((c) => <li>{c}</li>)}</ul>
    </div>
    <div class="reveal">
      <p class="prompt">locale</p>
      <h2>Languages</h2>
      <p class="lead">{profile.languages}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .intro { display: grid; grid-template-columns: 1.4fr 1fr; gap: 48px; align-items: center; padding-bottom: 40px; }
  .edu { display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); }
  .period { font-size: 0.8rem; color: var(--accent-2); }
  .school { color: var(--accent); margin: 0 0 6px; }
  .detail { color: var(--text-dim); font-size: 0.92rem; margin: 0; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; }
  .list { color: var(--text-dim); padding-left: 1.1em; }
  .list li { margin-bottom: 6px; }
  @media (max-width: 860px) { .intro, .two { grid-template-columns: 1fr; } }
</style>
