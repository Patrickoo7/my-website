---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Timeline from '../components/Timeline.astro';
import { profile } from '../data/profile';
import { url } from '../data/url';

const entries = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
const items = entries.map((e) => ({ ...e.data, html: e.rendered?.html ?? '' }));
---

<BaseLayout title="Experience" description={`Research and industry experience of ${profile.name}.`}>
  <section class="container page-head">
    <p class="eyebrow">Career</p>
    <h1>Experience</h1>
    <p class="lead">Research at Georgia Tech alongside 4.5+ years in industry, from enterprise data pipelines to production LLM platforms and edge vision.</p>
    <a class="btn" href={url('/cv')}>Resume & CV →</a>
  </section>
  <section class="container section">
    <Timeline items={items} />
  </section>
</BaseLayout>
