---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
import { url } from '../data/url';

const docs = [
  { id: 'cv', file: '/cv.pdf', label: 'Academic CV', audience: 'academia', blurb: 'For PhD admissions and research positions: interests, publications and research experience.' },
  { id: 'resume', file: '/resume.pdf', label: 'Resume', audience: 'industry', blurb: 'For engineering roles: production AI systems, impact and core skills.' },
];
---

<BaseLayout title="CV & Resume" description={`Download the academic CV and resume of ${profile.name}.`}>
  <section class="container page-head">
    <p class="eyebrow">Documents</p>
    <h1>CV & Resume</h1>
    <p class="lead">An academic CV for research applications and a resume for industry roles.</p>
  </section>

  <section class="container">
    <div class="docs">
      {
        docs.map((d) => (
          <div class="card doc reveal">
            <span class="eyebrow">For {d.audience}</span>
            <h2>{d.label}</h2>
            <p>{d.blurb}</p>
            <div class="actions">
              <a class="btn btn-primary" href={url(d.file)} target="_blank" rel="noopener">View PDF ↗</a>
              <a class="btn" href={url(d.file)} download={`Prateek_Awate_${d.label.replace(' ', '_')}.pdf`}>Download</a>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="container section preview" data-preview>
    <div class="tabs" role="tablist" aria-label="Preview document">
      {
        docs.map((d, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${d.id}`}
            aria-controls={`panel-${d.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-doc={d.id}
          >
            {d.label}
          </button>
        ))
      }
    </div>
    <div class="panel" role="tabpanel" id="panel-cv" aria-labelledby="tab-cv">
      <object class="pdf" data={url('/cv.pdf')} type="application/pdf" aria-label="Academic CV preview">
        <p>This browser cannot preview PDFs here. <a href={url('/cv.pdf')}>Open the Academic CV</a> instead.</p>
      </object>
    </div>
    <div class="panel" role="tabpanel" id="panel-resume" aria-labelledby="tab-resume" hidden>
      <object class="pdf" data={url('/resume.pdf')} type="application/pdf" aria-label="Resume preview">
        <p>This browser cannot preview PDFs here. <a href={url('/resume.pdf')}>Open the Resume</a> instead.</p>
      </object>
    </div>
  </section>
</BaseLayout>

<style>
  .docs { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .doc { padding: 32px; }
  .doc p { color: var(--text-dim); }
  .doc .eyebrow { display: block; margin-bottom: 0.2em; }
  .doc h2 { margin-top: 6px; }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .tabs {
    display: inline-flex;
    gap: 4px;
    padding: 4px;
    margin-bottom: 16px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-card);
  }
  .tabs button {
    font: 600 0.92rem var(--font-sans);
    padding: 8px 18px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--text-dim);
    cursor: pointer;
    transition: color 0.2s, background 0.2s;
  }
  .tabs button[aria-selected='true'] {
    background: var(--grad);
    color: #fff;
  }
  .pdf { width: 100%; height: 85vh; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-elev); }
  /* most mobile browsers can't render embedded PDFs; the buttons above open them instead */
  @media (max-width: 760px), (pointer: coarse) {
    .docs { grid-template-columns: 1fr; }
    .preview { display: none; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-preview]');
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement, focus = false) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
      });
      if (focus) tab.focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t));
      t.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        e.preventDefault();
        select(tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length], true);
      });
    });
    // cv#resume opens the page with the resume preview selected
    const syncHash = () => {
      const t = tabs.find((x) => `#${x.dataset.doc}` === location.hash);
      if (t) select(t);
    };
    syncHash();
    window.addEventListener('hashchange', syncHash);
  }
</script>
